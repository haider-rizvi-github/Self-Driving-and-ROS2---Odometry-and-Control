<?xml version="1.0"?>

<robot name="bumperbot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    

    <!-- Friction coefficients: To avoid slipping of the wheels -->
    <gazebo reference = "wheel_right_link">
        <mu1>1000000000000.0</mu1>
        <mu2>1000000000000.0</mu2>
        <kp>1000000000000.0</kp>
        <kd>1000000000000.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdirl>1 0 0</fdirl> <!-- indicates the direction of rotation of 
                                  wheel only for the wheels which can be accuated-->
    </gazebo>

    <gazebo reference = "wheel_left_link">
        <mu1>1000000000000.0</mu1>
        <mu2>1000000000000.0</mu2>
        <kp>1000000000000.0</kp>
        <kd>1000000000000.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdirl>1 0 0</fdirl> <!-- indicates the direction of rotation of 
                                  wheel only for the wheels which can be accuated-->

    </gazebo>

    <gazebo reference = "caster_front_link">
        <mu1>0.1</mu1>
        <mu2>0.1</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
    </gazebo>

    <gazebo reference = "caster_rear_link">
        <mu1>0.1</mu1>
        <mu2>0.1</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
    </gazebo>

</robot>
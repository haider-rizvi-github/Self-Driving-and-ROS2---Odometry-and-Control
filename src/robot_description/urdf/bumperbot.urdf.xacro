<?xml version="1.0"?>

<robot name="bumperbot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- Define the robot's links and joints -->

    <!-- Parent link -->
    <link name="world"/> 

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/> 
            <geometry>
                <mesh filename="package://robot_description/meshes/base_link.STL"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
    </link>

    <link name="wheel_right_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.57 0 0"/> 
            <geometry>
                <mesh filename="package://robot_description/meshes/wheel_right_link.STL"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
    </link>

    <link name="wheel_left_link">
        <visual>
            <origin xyz="0 0 0" rpy="-1.57 0 0"/> 
            <geometry>
                <mesh filename="package://robot_description/meshes/wheel_left_link.STL"/>
            </geometry>
            <material name="green">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
    </link>

    <link name="caster_front_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/> 
            <geometry>
                <mesh filename="package://robot_description/meshes/caster_front_link.STL"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
    </link>
    <link name="caster_rear_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/> 
            <geometry>
                <mesh filename="package://robot_description/meshes/caster_rear_link.STL"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
    </link>
    


    <!-- Define the joint connecting the base_link to the world -->
    <joint name="base_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.033" rpy="0 0 0"/>
    </joint>

    <!-- Define the joint connecting the wheel_right_link and wheel_left_link to the base_link -->
    <joint name="wheel_right_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_right_link"/>
        <origin xyz="0 -0.077 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>         <!-- The axis of rotation for the wheel around Y-axis -->
    </joint>

    <joint name="wheel_left_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_left_link"/>
        <origin xyz="0 0.077 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>         <!-- The axis of rotation for the wheel around Y-axis -->
    </joint>

    <!-- Define the joint connecting the caster_front_link and caster_rear_link to the base_link -->
    <joint name="caster_front_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_front_link"/>
        <origin xyz="0.04755 0 -0.027" rpy="0 0 0"/>
    </joint>

    <joint name="caster_rear_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_rear_link"/>
        <origin xyz="-0.04755 0 -0.027" rpy="0 0 0"/>
    </joint>

</robot>